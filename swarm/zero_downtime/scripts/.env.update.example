# Update Configuration

# ============================================
# Version Variables
# ============================================

# WORKERS
SIMPLIFICATION_IMAGE="your-registry/simplification-bundle"
NEW_VERSION="1.2.3"

# WEB Layer
SYMFONY_IMAGE="your-registry/symfony-app"
NEW_SYMFONY_VERSION="8.2.0"
NGINX_IMAGE="nginx"
NEW_NGINX_VERSION="1.27-alpine"

# Traefik
TRAEFIK_VERSION="v3.6.12"

# Database
MARIADB_VERSION="11.4.9"
BACKUP_PATH="/opt/backups/mariadb/latest.sql"

# ============================================
# Environment-specific Settings
# ============================================

# PREPROD Environment
PREPROD_PHP_REPLICAS=2
PREPROD_NGINX_REPLICAS=2
PREPROD_TRAEFIK_REPLICAS=2
PREPROD_SIMPLIFICATION_REPLICAS=1

# PROD Environment
PROD_PHP_REPLICAS=3
PROD_NGINX_REPLICAS=3
PROD_TRAEFIK_REPLICAS=3
PROD_SIMPLIFICATION_REPLICAS=2

# ============================================
# Update Timing (in seconds)
# ============================================

# Delays between each replica update
WORKER_UPDATE_DELAY=30
WEB_UPDATE_DELAY=45
TRAEFIK_UPDATE_DELAY=40
DB_UPDATE_DELAY=60

# Monitor duration after each replica update
WORKER_MONITOR=20
WEB_MONITOR=30
TRAEFIK_MONITOR=30
DB_MONITOR=60

# Convergence timeout
CONVERGENCE_TIMEOUT=300

# ============================================
# Drian/Cooling periods (in seconds)
# ============================================

# Grace period before forcing container stop
GRACE_PERIOD_WEB=45
GRACE_PERIOD_WORKER=30
GRACE_PERIOD_TRAEFIK=40
GRACE_PERIOD_DB=60

# Wait after scaling operations
SCALE_UP_WAIT=60
SCALE_DOWN_WAIT=30

# ============================================
# Health Check Settings
# ============================================

# Health check intervals
HEALTHCHECK_INTERVAL=10s
HEALTHCHECK_TIMEOUT=5s
HEALTHCHECK_RETRIES=3
HEALTHCHECK_START_PERIOD_WEB=30s
HEALTHCHECK_START_PERIOD_DB=45s
HEALTHCHECK_START_PERIOD_TRAEFIK=30s

# ============================================
# Failure Handling
# ============================================

# Max failure ratio before rollback (0.0 = 0%, 0.5 = 50%)
WEB_MAX_FAILURE_RATIO=0.1
WORKER_MAX_FAILURE_RATIO=0.25
TRAEFIK_MAX_FAILURE_RATIO=0.0
DB_MAX_FAILURE_RATIO=0.0

# ============================================
# Monitoring & Alerts
# ============================================

# Enable Slack/Email notifications
ENABLE_NOTIFICATIONS=true
SLACK_WEBHOOK_URL="https://hooks.slack.com/services/YOUR/WEBHOOK/URL"

# Monitor cpu/memory during update
ENABLE_METRICS=true

# ============================================
# Backup & Rollback
# ============================================

# Auto-backup before update
AUTO_BACKUP_DB=true
BACKUP_RETENTION_DAYS=7

# Allow automatic rollback on health check failure
AUTO_ROLLBACK_ON_HEALTH_FAILURE=true

# ============================================
# Dry Run Mode
# ============================================

# Set to true to simulate without making changes
DRY_RUN=false

# ============================================
# Verbosity
# ============================================

VERBOSE=true
